rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ==============================================================================
    // 1. USER PROFILE PRIVACY
    // ==============================================================================
    match /users/{userId} {
      // Students can ONLY read their own profile; admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // Creating account: cannot self-assign role = 'admin'
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                    request.resource.data.role == 'student';
                    
      // Updates: regular users cannot alter their role or status; admins can update all
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      
      allow delete: if isAdmin();
    }

    // ACCA PAPERS (Public catalog)
    match /papers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TOPICS (Public syllabus topics)
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================================
    // 2. MCQ QUESTION & ANSWER PROTECTION
    // ==============================================================================
    // Public question information (text, options, difficulty, marks) - NO correct answer or explanation
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private answer information (correctOptionId, explanation)
    // Only accessible by administrators OR an authenticated student who has recorded an attempt for that question
    match /question_answers/{questionId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/question_attempts/$(request.auth.uid + '_' + questionId))
      );
      allow write: if isAdmin();
    }

    // QUESTION ATTEMPTS
    match /question_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // SAVED QUESTIONS (Bookmarks)
    match /saved_questions/{savedId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if false;
    }

    // MOCK EXAMS (Exam syllabus configuration)
    match /mock_exams/{mockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==============================================================================
    // 3. EXAM ATTEMPT PROTECTION
    // ==============================================================================
    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Updates permitted during in-progress autosaving, but FROZEN once submitted or timed out!
      // Students cannot modify an already submitted attempt or touch another student's attempt.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        resource.data.status != 'submitted' &&
        resource.data.status != 'timed_out'
      );
      
      allow delete: if isAdmin();
    }

    // LEARNING RESOURCES
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PLATFORM SETTINGS (Public contact & community links, admin editable)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
